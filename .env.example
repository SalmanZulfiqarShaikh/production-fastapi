# Copy to .env and fill in. .env is gitignored; this file is the template.

# Required. The app refuses to start without it.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
X_API_KEY=change-me

# Defaults to a local SQLite file. Point at Postgres in production, e.g.
# postgresql+psycopg://user:pass@host:5432/kitaab
DATABASE_URL=sqlite:///kitaab.db

# Logs every SQL statement. Useful locally, noisy in production.
SQL_ECHO=false

# Comma-separated. Never use "*" together with allow_credentials=True.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
